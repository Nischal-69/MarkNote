{
  "manifest_version": 3,
  "name": "MarkNote — PDF & Web Highlighter + Notes",
  "short_name": "MarkNote",
  "version": "0.12.0",
  "description": "Highlight text and add notes while reading.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MarkNote"
  },
  "permissions": ["activeTab", "storage", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["storage/storage.js", "pdf/pdf-detector.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
